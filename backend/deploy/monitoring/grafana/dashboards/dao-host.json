    {
      "id": 1,
      "title": "Один VPS · только ресурсы хоста",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Обновление раз в минуту · история до 3 дней. **Нет данных — не нулевая нагрузка.** Этот экран не подтверждает доступность сайта или доставку заявок Telegram. Метрики не содержат заявки и журналы запросов."
      }
    },
    {
      "id": 2,
      "title": "Сбор метрик",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dao-prometheus"
      },
      "description": "Проверяет последний сбор Prometheus. Не проверяет API или Telegram.",
      "interval": "30s",
      "maxDataPoints": 240,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Нет данных",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступен",
                  "color": "red"
                },
                "1": {
                  "text": "Работает",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\"}",
          "legendFormat": "node_exporter",
          "datasource": {
            "type": "prometheus",
            "uid": "dao-prometheus"
          },
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
