{
  "name": "dao-coffee-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DAO COFFEE GROUP — корпоративный лендинг",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "dev:backend": "node backend/preview.mjs",
    "start:backend": "node --env-file-if-exists=.env backend/server.mjs",
    "test": "node --test backend/test/*.test.mjs",
    "dev:bitrix": "node --env-file=.env backend/preview.mjs --bitrix",
    "inspect:bitrix": "node --env-file=.env backend/inspect-bitrix.mjs",
    "journal:leads": "node --env-file-if-exists=.env backend/journal.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
