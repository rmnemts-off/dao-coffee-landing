# Only application code, public assets and developer instructions belong in Git.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/package.json
!/package-lock.json
!/site/
!/scripts/
!/docs/
!/backend/
!/netlify/
!/netlify.toml
!/.github/
!/.env.example

**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/dist/
**/.netlify/
**/__pycache__/
*.log

